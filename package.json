{
  "name": "focus-testing",
  "version": "1.0.0",
  "description": "Playwright test suite and exploratory-testing workspace for the Focus web application",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium tests/smoke",
    "test:api": "playwright test --project=chromium tests/api",
    "test:reports": "playwright test --project=chromium tests/reports",
    "test:integrity": "playwright test --project=chromium tests/integrity",
    "test:destructive": "playwright test --project=destructive",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen --viewport-size=1600,1000 http://vst-focus-seven",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc --noEmit",
    "axosoft:verify": "node scripts/verify-axosoft.mjs",
    "axosoft:dry-run": "playwright test --project=chromium",
    "codegen:save": "playwright codegen --viewport-size=1600,1000 -o test-results/recorded.spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}