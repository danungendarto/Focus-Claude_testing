# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
# Run `npm run axosoft:verify` after editing; it is read-only and prints the ids.

# --- Focus itself ---------------------------------------------------------
FOCUS_BASE_URL=http://vst-focus-seven

# --- Axosoft connection ---------------------------------------------------
AXOSOFT_URL=https://youraccount.axosoft.com
# AXOSOFT_API_VERSION=v5          # try v6 if /api/v5/projects 404s

# Axosoft has NO personal access tokens. Generate an API key under:
#   Tools > System Settings > Axosoft API Settings > Manage API Keys
#   (your version may label that menu "System Options" - same thing)
#     - tick "Enable Axosoft API"
#     - "Generate New API Keys"
#     - register it as a PRIVATE application (required for the grant below)
AXOSOFT_CLIENT_ID=
AXOSOFT_CLIENT_SECRET=

# Your own Axosoft login. Use a dedicated service account if you can, so
# defects are attributed to automation rather than to a person.
AXOSOFT_USERNAME=
AXOSOFT_PASSWORD=

# Optional: reuse a token obtained elsewhere instead of the credentials above.
# AXOSOFT_TOKEN=

# --- Where defects go -----------------------------------------------------
AXOSOFT_PROJECT_ID=
# AXOSOFT_PRIORITY_ID=
# AXOSOFT_ASSIGNED_TO_ID=
# AXOSOFT_RELEASE_ID=

# --- Safety ---------------------------------------------------------------
# Unset or 0 = dry run: failures are printed, nothing is written to Axosoft.
# Set to 1 ONLY where you want real defects created (i.e. CI, not laptops).
AXOSOFT_CREATE_DEFECTS=0

# Circuit breaker. Above EITHER threshold, one run-wide defect is filed
# instead of one per test -- a mass failure is one cause, not many bugs.
# AXOSOFT_MAX_DEFECTS=8
# AXOSOFT_MAX_FAILURE_RATIO=0.25

# Optional: base URL where CI publishes test-results/, so defects can link
# to traces and screenshots instead of naming local file paths.
# FOCUS_ARTIFACT_BASE_URL=https://ci.example.com/job/focus/lastBuild/artifact/test-results
